# Copy this file to .env and replace every placeholder with local or deployment values.
# Never commit .env or real credentials.

# Backend HTTP server
SERVER_PORT=8080

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=4242
DB_USER=replace-with-local-db-user
DB_PASSWORD=replace-with-local-db-password
DB_NAME=mydb
DB_SSLMODE=disable

# Frontend public configuration (Vite exposes only variables prefixed with VITE_)
VITE_GEOCODING_API_URL=https://api-adresse.data.gouv.fr/search/
